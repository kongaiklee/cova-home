# Client-side build values. Anything prefixed VITE_ is compiled into the bundle and is
# therefore public by construction - never put a secret here or in the Vercel Preview
# environment expecting it to stay private.

# GA4 measurement ID for covarage.com. Set the real value in the Vercel project
# (Production), not in this file: the ID is not a secret but the commit is not where it
# belongs. Leave it unset anywhere you do not want the tag - index.html creates no loader
# unless the value looks like a measurement ID.
VITE_GA4_ID=G-XXXXXXXXXX
