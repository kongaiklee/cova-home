{
  "buildCommand": "npm run build",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/llms-full.txt",
      "destination": "/llms.txt",
      "permanent": true
    },
    {
      "source": "/guides",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/:category(regulatory-change|procedural-howto|comparison|crisis|association|document-legal|emerging-risk|edge-case|cross-border|decision-tree|licensing)/:path*",
      "destination": "/guides/:category/:path*",
      "permanent": true
    },
    {
      "source": "/for-partners/calculator",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:drop(for-partners|for-corpsecs|for-brokers)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/decks/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/feed.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/ig-content/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
