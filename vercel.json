{
  "buildCommand": "npm run build",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/for-partners/calculator", "destination": "/decks/CovaPartnership_Calculator_Mobile" },
    { "source": "/for-partners", "destination": "/decks/CovaPartnership_Mobile" },
    { "source": "/for-corpsecs", "destination": "/decks/CovaPartnership_Mobile" },
    { "source": "/for-brokers", "destination": "/decks/CovaBroker_Mobile" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/decks/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/ig-content/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
